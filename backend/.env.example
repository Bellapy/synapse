# Obrigatória: chave do Google AI Studio
GOOGLE_API_KEY=

# Modelo do Gemini (padrão: gemini-2.5-flash)
AI_MODEL_NAME=gemini-2.5-flash

# URL do frontend (CORS). Em produção: https://seu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Opcionais: sem elas o cache e o histórico de buscas ficam desativados
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://user:password@localhost:5432/synapse_db
