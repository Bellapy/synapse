# Obrigatória: chave do Google AI Studio
GOOGLE_API_KEY=

# Modelo do Gemini (padrão: gemini-3.5-flash-lite, ~2-5s por resposta)
AI_MODEL_NAME=gemini-3.5-flash-lite
# AI_TIMEOUT_SECONDS=45
# AI_MAX_RETRIES=2

# CORS: origens do frontend separadas por vírgula (localhost:5173 já é liberado)
FRONTEND_URL=http://localhost:5173
# Regex extra de origens (padrão cobre https://synapse-*.vercel.app)
# CORS_ORIGIN_REGEX=

# Máximo de requisições por minuto por IP nos endpoints de IA (0 desativa)
# RATE_LIMIT_PER_MINUTE=10

# Opcionais: sem elas o cache e o histórico de buscas ficam desativados
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://user:password@localhost:5432/synapse_db
